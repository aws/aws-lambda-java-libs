ARG BASE_REGISTRY=public.ecr.aws
ARG DISTRO_VERSION

FROM ${BASE_REGISTRY}/amazonlinux/amazonlinux:${DISTRO_VERSION}

RUN yum install -y java-1.8.0-openjdk

ADD aws-lambda-java-runtime-interface-client/test/integration/test-handler/target/HelloWorld-1.0.jar .

ARG RIE
ADD aws-lambda-java-runtime-interface-client/test/integration/resources/${RIE}.tar.gz /usr/bin/

ENTRYPOINT ["java", "-jar", "./HelloWorld-1.0.jar"]

CMD ["helloworld.App"]
